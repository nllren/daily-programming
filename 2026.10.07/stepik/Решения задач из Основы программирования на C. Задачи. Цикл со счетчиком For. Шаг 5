//Решения задач из Основы программирования на C. Задачи. Цикл со счетчиком For. Шаг 5
//Вывести через пробел все целые числа из промежутка [A,B],(A<B) в обратном порядке

 #include <stdio.h>

int main(void) {
    int A, B;
    
    if (scanf("%d %d", &A, &B) != 2) {
        return 1;
    }

 
    for (int i = B; i >= A; i--) {
        printf("%d ", i);
    }
    printf("\n");

    return 0;
}

