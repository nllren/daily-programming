//Решения задач из Основы программирования на C. Задачи. Закрепление синтаксиса For. Шаг 11
// На вход программе подаётся натуральное число M  
// Напишите программу, которая выводит на экран 3 строки в каждой из которых по M символов *.

#include <stdio.h>
int main(void)
{
    int M;
    scanf("%d", &M);
 for (int i = 0; i < 3; i++) {
     for (int j = 0; j < M; j++) {
      printf("*");
 }
     printf("\n"); 
 }
    return 0;
}
