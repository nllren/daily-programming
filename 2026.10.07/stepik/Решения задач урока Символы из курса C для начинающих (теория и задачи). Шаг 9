//Решения задач урока Символы из курса C для начинающих (теория и задачи). Шаг 9
//В игре Королевство кроликов доска 10х10 клеток. Ряды кодируются буквами ABCDEFGHIJ сверху вниз, столбцы кодируются числами от 1 до 10 слева направо.

#include <stdio.h>

int main(void) {
    char row;
    int col;

     scanf("%c %d", &row, &col);

    
    printf ("%c%d ", row - 1, col);
    printf ("%c%d ", row, col + 1);
    printf ("%c%d ", row + 1, col);
     printf ("%c%d", row, col - 1);
    

    return 0;
}



