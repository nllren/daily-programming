//Решения задач из Основы программирования на C. Задачи. Закрепление синтаксиса For. Шаг 10
//На вход программе подаётся натуральное число M. 
//Напишите программу, которая выводит на экран M символов *.

#include <stdio.h>
int main(void)
{
    int M;
    scanf("%d", &M);
 for (int i = 0; i < M; i++) {
      printf("*");
 }
    return 0;
}
