//Решения задач из Основы программирования на C. Задачи. Закрепление синтаксиса For. Шаг 12
//На вход программе подаётся два натуральных числа N и M.    
// Напишите программу, которая выводит на экран N строк в каждой из которых по M символов *.

#include <stdio.h>
int main(void)
{
    int N, M;
    scanf("%d %d", &N, &M);
 for (int i = 0; i < N; i++) {
     for (int j = 0; j < M; j++) {
      printf("*");
 }
     printf("\n"); 
 }
    return 0;
}
