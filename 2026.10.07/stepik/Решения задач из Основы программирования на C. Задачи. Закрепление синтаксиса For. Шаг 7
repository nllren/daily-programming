//Вывести таблицу значений функции 

#include <stdio.h>

int main() {
    
    for (double x = -3.0; x <= 3.0 + 0.001; x += 0.5) {
        
        printf("%5.2f | %8.3f\n", x, x * x * x);
    }
    
    return 0;
}
