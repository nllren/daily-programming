//Решения задач из Основы программирования на C. Задачи. Цикл со счетчиком For. Шаг 2. 

//Написать программу выводящую на экран первые N натуральных чисел.

#include <stdio.h>

int main(void) {
    int n;
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        printf("%d ", i);
    }

    return 0;
}
