//Решения задач из Основы программирования на C. Задачи. Цикл со счетчиком For. Шаг 4
//Усовершенствовать программу, написанную на прошлом шаге: дополнительно на отдельной строке вывести количество напечатанных чисел.
 #include <stdio.h>

int main(void) {
    int K, M;
    scanf("%d %d", &K, &M);

    int count = 0; 

    if (K < 1) {
        K = 1; 
    }
 
    for (int i = K; i <= M; i++) {
        printf("%d ", i);
        count++; 
    }

    printf("\n");
    printf("%d\n", count);

    return 0;
}
