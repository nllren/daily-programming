//Решения задач из Основы программирования на C. Задачи. Цикл со счетчиком For. Шаг 3
//Усовершенствуйте программу, написанную на прошлом шаге. Теперь необходимо вывести все натуральные числа из промежутка [K,M],(K<M)

#include <stdio.h>

int main(void) {
    int K, M;
    scanf("%d %d", &K, &M);
if (K < 1) {
    K = 1; 
}
    for (int i = K; i <= M; i++) {
        printf("%d ", i);
    }

    return 0;
}
