//Решения задач из Основы программирования на C. Задачи. Закрепление синтаксиса For. Шаг 13
// Измените программу, написанную на прошлом шаге, так, что если X = номер_строки + номер_столбца чётное, то выводим символ *, если нечётное, то выводим -.

#include <stdio.h>
int main(void)
{
    int N, M;
    scanf("%d %d", &N, &M);
 for (int i = 1; i <= N; i++) {
     for (int j = 1; j <= M; j++) {
         if ((i + j) % 2 == 0) {
      printf("*");
         } else {
             printf("-");
         }
 }
     printf("\n"); 
 }
    return 0;
}
